funkin/play/scoring/Scoring.hx : 
funkin/play/scoring/Scoring.hx : // we can return null here, meaning that the player hasn't actually played and finished the song (thus has no data)
funkin/play/scoring/Scoring.hx : if (scoreData.tallies.totalNotes == 0) return null;
funkin/play/scoring/Scoring.hx : 
funkin/play/scoring/Scoring.hx : // Perfect (Gold) is a Sick Full Clear
funkin/play/scoring/Scoring.hx : if (scoreData.tallies.sick == scoreData.tallies.totalNotes)
